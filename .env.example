# kravu configuration
#
# IMPORTANT: kravu never collects or stores API keys for you. Set your provider's
# key here (or in your shell environment) BEFORE running kravu. `kravu init` only
# selects the provider/model; if the required key is missing it will hard-stop and
# tell you which variable to set.

# --- Model (chosen by `kravu init`, or set manually) ------------------------
# The value is passed straight to LiteLLM. kravu is provider-agnostic and does
# NOT hardcode a model — KRAVU_MODEL must be set here (or in the environment).
# `kravu init` writes it for you. Options (verified against Google AI Studio
# 2026-09-08; model names change often — override freely):
#   gemini/gemma-4-26b-a4b-it (default; smaller/faster; needs GEMINI_API_KEY)
#   gemini/gemma-4-31b-it     (larger Gemma; needs GEMINI_API_KEY)
#   gemini/gemini-2.5-flash   (most reliable free tier; needs GEMINI_API_KEY)
#   ollama/qwen3.5:4b         (local, small, no key)
#   ollama/qwen3.8:27b        (local, latest, needs a strong GPU, no key)
#   anthropic/claude-sonnet-5 (needs ANTHROPIC_API_KEY)
#   gpt-6-astra               (needs OPENAI_API_KEY)
KRAVU_MODEL=gemini/gemma-4-26b-a4b-it

# --- Provider API key (set the one your model needs; NOT set by kravu) ------
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# (Ollama models are local and need no key.)

# --- Pipeline defaults (optional) -------------------------------------------
# Minimum fit score (1-10) for a job to proceed to tailoring.
KRAVU_MIN_SCORE=7

# Cover-letter policy: always | only_if_required | never
KRAVU_COVER_LETTER=only_if_required
