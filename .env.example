# --- LLM provider (any one) -------------------------------------------------
# kravu uses LiteLLM, so any supported provider works. Set the model and the
# matching API key. Default is Google Gemini (has a free tier).

# The model string is passed straight to LiteLLM.
#   Gemini:    gemini/gemini-2.0-flash
#   OpenAI:    gpt-4o-mini
#   Anthropic: anthropic/claude-3-5-sonnet-latest
#   Ollama:    ollama/llama3.1         (local, no key needed)
KRAVU_MODEL=gemini/gemini-2.0-flash

# Provide the key for whichever provider your model uses:
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=

# --- Pipeline defaults (optional) -------------------------------------------
# Minimum fit score (1-10) for a job to proceed to tailoring.
KRAVU_MIN_SCORE=7
